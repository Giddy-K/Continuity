# Continuity - environment variables
#
# Copy this file to `.env` (repo root) and/or `agent/.env` / `frontend/.env.local`
# and fill in real values. NEVER commit the real `.env` file - it is git-ignored.
# In deployed environments (Cloud Run), these are injected via Secret Manager,
# not from this file.

# ---------------------------------------------------------------------------
# GCP / Vertex AI Agent Engine
# ---------------------------------------------------------------------------
# Ask the project owner for the real values below - they must match an
# existing GCP project. Do not guess or invent them.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Gemini model used by the ADK agent (see agent/config.py)
GEMINI_MODEL=gemini-2.5-flash

# Cloud Storage bucket used as a staging bucket when deploying to Agent Engine
AGENT_ENGINE_STAGING_BUCKET=gs://your-staging-bucket

# Service account the agent runs as on Cloud Run / Agent Engine
GCP_SERVICE_ACCOUNT_EMAIL=continuity-agent@your-gcp-project-id.iam.gserviceaccount.com

# ---------------------------------------------------------------------------
# Grafana Cloud (metrics/logs source + alerting)
# ---------------------------------------------------------------------------
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_API_KEY=changeme-service-account-token
# Optional: separate datasource UIDs if not auto-discovered
GRAFANA_PROMETHEUS_DATASOURCE_UID=changeme
GRAFANA_LOKI_DATASOURCE_UID=changeme

# ---------------------------------------------------------------------------
# Postgres (incident + decision audit trail)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://continuity:changeme@localhost:5432/continuity
PGHOST=localhost
PGPORT=5432
PGDATABASE=continuity
PGUSER=continuity
PGPASSWORD=changeme

# ---------------------------------------------------------------------------
# Frontend (Next.js reasoning-trail dashboard)
# ---------------------------------------------------------------------------
# Read-only DB connection or API base URL the frontend uses to display the
# agent's incident/decision log.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
DATABASE_URL_READONLY=postgresql://continuity_ro:changeme@localhost:5432/continuity

# ---------------------------------------------------------------------------
# Remediation guardrails (bounded action safety limits)
# ---------------------------------------------------------------------------
# Comma-separated allowlist of remediation actions the agent may take
# autonomously without human approval.
REMEDIATION_ACTION_ALLOWLIST=restart_node,rollback_deploy,file_incident_report
MAX_AUTONOMOUS_REMEDIATIONS_PER_HOUR=3
