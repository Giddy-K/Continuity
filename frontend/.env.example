# Frontend-only env vars (copy to frontend/.env.local for local dev).
# See the repo-root .env.example for the full set used across services.

# Read-only Postgres connection the dashboard queries to render the
# incident/decision reasoning trail. Should use a read-only DB role
# (see db/migrations/001_init.sql for the continuity_ro role).
DATABASE_URL_READONLY=postgresql://continuity_ro:changeme@localhost:5432/continuity
