{
  "title": "Render Pipeline",
  "uid": "continuity-render-pipeline",
  "tags": ["continuity", "render-pipeline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Render Job Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(render_job_duration_seconds_bucket[5m])) by (le, worker))"
        }
      ]
    },
    {
      "id": 2,
      "title": "Render Job Failure Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(render_jobs_failed_total[5m])) / sum(rate(render_jobs_total[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Render Worker Node Status",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "render_worker_up"
        }
      ]
    }
  ]
}
