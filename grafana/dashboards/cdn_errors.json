{
  "title": "CDN Error Rates",
  "uid": "continuity-cdn-errors",
  "tags": ["continuity", "cdn"],
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "5xx Rate by Edge Region",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cdn_requests_total{status=~\"5..\"}[5m])) by (region) / sum(rate(cdn_requests_total[5m])) by (region)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Origin Fetch Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(cdn_origin_fetch_seconds_bucket[5m])) by (le, region))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Cache Hit Ratio",
      "type": "stat",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cdn_cache_hits_total[5m])) / sum(rate(cdn_requests_total[5m]))"
        }
      ]
    }
  ]
}
