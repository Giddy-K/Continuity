{
  "title": "License Check Service",
  "uid": "continuity-license-checks",
  "tags": ["continuity", "license-check"],
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "License Check Failure Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(license_checks_failed_total[5m])) / sum(rate(license_checks_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "title": "License Check Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(license_check_duration_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Recent Denials by Reason",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(license_checks_denied_total[1h])) by (reason)"
        }
      ]
    }
  ]
}
